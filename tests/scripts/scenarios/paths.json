[
  {
    "name": "empty directory outside git: the current directory is the root",
    "args": ["paths", "--json"],
    "expect": {
      "json": {
        "root": "{root}",
        "dir": "{root}/.agentic-task-manager",
        "tasks": "{root}/.agentic-task-manager/tasks.json",
        "tasks_exists": false,
        "dashboard": "{root}/.agentic-task-manager/tasks-dashboard.html",
        "legacy": null
      }
    }
  },
  {
    "name": "inside a git repository the root is the top level, from any subdirectory",
    "setup": { "git": true, "files": { "src/a/x.txt": "x" } },
    "cwd": "src/a",
    "args": ["paths", "--json"],
    "expect": {
      "json": {
        "root": "{root}",
        "dir": "{root}/.agentic-task-manager",
        "tasks": "{root}/.agentic-task-manager/tasks.json",
        "tasks_exists": false,
        "dashboard": "{root}/.agentic-task-manager/tasks-dashboard.html",
        "legacy": null
      }
    }
  },
  {
    "name": "new location",
    "setup": { "git": true, "files": { ".agentic-task-manager/tasks.json": { "tasks": [] } } },
    "args": ["paths", "--json"],
    "expect": {
      "json": {
        "root": "{root}",
        "dir": "{root}/.agentic-task-manager",
        "tasks": "{root}/.agentic-task-manager/tasks.json",
        "tasks_exists": true,
        "dashboard": "{root}/.agentic-task-manager/tasks-dashboard.html",
        "legacy": null
      }
    }
  },
  {
    "name": "legacy docs/ location with a dashboard",
    "setup": {
      "git": true,
      "files": { "docs/tasks.json": { "tasks": [] }, "docs/tasks-dashboard.html": "<html></html>" }
    },
    "cwd": "docs",
    "args": ["paths", "--json"],
    "expect": {
      "json": {
        "root": "{root}",
        "dir": "{root}/.agentic-task-manager",
        "tasks": "{root}/.agentic-task-manager/tasks.json",
        "tasks_exists": false,
        "dashboard": "{root}/.agentic-task-manager/tasks-dashboard.html",
        "legacy": { "tasks": "{root}/docs/tasks.json", "dashboard": "{root}/docs/tasks-dashboard.html" }
      }
    }
  },
  {
    "name": "legacy root location without a dashboard",
    "setup": { "files": { "tasks.json": { "tasks": [] } } },
    "args": ["paths", "--json"],
    "expect": {
      "json": {
        "root": "{root}",
        "dir": "{root}/.agentic-task-manager",
        "tasks": "{root}/.agentic-task-manager/tasks.json",
        "tasks_exists": false,
        "dashboard": "{root}/.agentic-task-manager/tasks-dashboard.html",
        "legacy": { "tasks": "{root}/tasks.json", "dashboard": null }
      }
    }
  },
  {
    "name": "docs/ wins over the root when both legacy locations exist",
    "setup": { "files": { "tasks.json": { "tasks": [] }, "docs/tasks.json": { "tasks": [] } } },
    "args": ["paths", "--json"],
    "expect": {
      "json": {
        "root": "{root}",
        "dir": "{root}/.agentic-task-manager",
        "tasks": "{root}/.agentic-task-manager/tasks.json",
        "tasks_exists": false,
        "dashboard": "{root}/.agentic-task-manager/tasks-dashboard.html",
        "legacy": { "tasks": "{root}/docs/tasks.json", "dashboard": null }
      }
    }
  },
  {
    "name": "text output",
    "setup": { "files": { "docs/tasks.json": { "tasks": [] } } },
    "args": ["paths"],
    "expect": {
      "stdout": "root: {root}\ndir: {root}/.agentic-task-manager\ntasks: {root}/.agentic-task-manager/tasks.json\ndashboard: {root}/.agentic-task-manager/tasks-dashboard.html\nlegacy: {root}/docs/tasks.json\n"
    }
  }
]
