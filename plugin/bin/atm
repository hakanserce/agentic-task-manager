#!/bin/sh
# atm on the Bash tool's PATH: Claude Code puts a plugin's bin/ there while the plugin is enabled, so skills run plain
# `atm` and one permission rule, Bash(atm *), survives upgrades. The launcher itself stays in scripts/ (the tasks.json
# merge driver registered in each clone points at it).
exec "$(cd "$(dirname "$0")/../scripts" && pwd)/atm" "$@"
