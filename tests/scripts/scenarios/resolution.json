[
  {
    "name": "skip --resolution duplicate --duplicate-of: the task it duplicates may be archived (SR-2.8)",
    "setup": {
      "files": {
        ".agentic-task-manager/tasks.json": { "tasks": [{ "id": "T-2", "status": "todo" }] },
        ".agentic-task-manager/tasks-archive.json": { "tasks": [{ "id": "T-1", "status": "done" }] }
      }
    },
    "env": { "ATM_AGENT": "bob", "ATM_NOW": "2026-05-01T12:00:00Z" },
    "args": ["skip", "T-2", "--reason", "Same as T-1", "--resolution", "duplicate", "--duplicate-of", "T-1"],
    "expect": {
      "files": {
        ".agentic-task-manager/tasks.json": {
          "tasks": [
            {
              "id": "T-2",
              "status": "skipped",
              "updated_at": "2026-05-01T12:00:00Z",
              "updated_by": "bob",
              "skipped_at": "2026-05-01T12:00:00Z",
              "resolution": "duplicate",
              "duplicate_of": "T-1",
              "notes": [{ "at": "2026-05-01T12:00:00Z", "by": "bob", "kind": "note", "text": "Skipped: Same as T-1" }]
            }
          ]
        }
      }
    }
  },
  {
    "name": "skip --resolution obsolete; the default, won't do, isn't stored",
    "setup": {
      "files": {
        ".agentic-task-manager/tasks.json": {
          "tasks": [
            { "id": "T-1", "status": "todo" },
            { "id": "T-2", "status": "todo" }
          ]
        }
      },
      "commands": [["sh", "-c", "\"$ATM\" skip T-2 --reason 'Not needed' --agent bob"]]
    },
    "env": { "ATM_AGENT": "bob", "ATM_NOW": "2026-05-01T12:00:00Z" },
    "args": ["skip", "T-1", "--reason", "Gone", "--resolution", "obsolete", "--json"],
    "expect": {
      "json": {
        "id": "T-1",
        "status": "skipped",
        "updated_at": "2026-05-01T12:00:00Z",
        "updated_by": "bob",
        "skipped_at": "2026-05-01T12:00:00Z",
        "resolution": "obsolete",
        "notes": [{ "at": "2026-05-01T12:00:00Z", "by": "bob", "kind": "note", "text": "Skipped: Gone" }],
        "claim": null
      },
      "files": { ".agentic-task-manager/tasks.json": true }
    }
  },
  {
    "name": "...and the task skipped with the default has no resolution stored",
    "setup": { "files": { ".agentic-task-manager/tasks.json": { "tasks": [{ "id": "T-2", "status": "todo" }] } } },
    "env": { "ATM_AGENT": "bob", "ATM_NOW": "2026-05-01T12:00:00Z" },
    "args": ["skip", "T-2", "--reason", "Not needed", "--json"],
    "expect": {
      "json": {
        "id": "T-2",
        "status": "skipped",
        "updated_at": "2026-05-01T12:00:00Z",
        "updated_by": "bob",
        "skipped_at": "2026-05-01T12:00:00Z",
        "notes": [{ "at": "2026-05-01T12:00:00Z", "by": "bob", "kind": "note", "text": "Skipped: Not needed" }],
        "claim": null
      }
    }
  },
  {
    "name": "--duplicate-of needs --resolution duplicate, another task, and one that exists; nothing changes",
    "setup": {
      "files": {
        ".agentic-task-manager/tasks.json": {
          "tasks": [
            { "id": "T-1", "status": "todo" },
            { "id": "T-2", "status": "todo" }
          ]
        }
      },
      "commands": [
        ["sh", "-c", "\"$ATM\" skip T-2 --reason x --duplicate-of T-1 2> no-resolution.txt; true"],
        ["sh", "-c", "\"$ATM\" skip T-2 --reason x --resolution duplicate --duplicate-of T-2 2> itself.txt; true"]
      ]
    },
    "args": ["skip", "T-2", "--reason", "x", "--resolution", "duplicate", "--duplicate-of", "T-9"],
    "expect": {
      "exit": 2,
      "stderrIncludes": ["atm: T-2 can't be a duplicate of T-9, which doesn't exist"],
      "files": {
        "no-resolution.txt": "atm: --duplicate-of goes with --resolution duplicate\n",
        "itself.txt": "atm: T-2 can't be a duplicate of itself\n",
        ".agentic-task-manager/tasks.json": {
          "tasks": [
            { "id": "T-1", "status": "todo" },
            { "id": "T-2", "status": "todo" }
          ]
        }
      }
    }
  },
  {
    "name": "done --resolution: stored when it isn't done; reopen clears it",
    "setup": {
      "files": {
        ".agentic-task-manager/tasks.json": {
          "tasks": [{ "id": "T-1", "status": "in_progress", "started_by": "bob" }]
        }
      },
      "commands": [["sh", "-c", "\"$ATM\" done T-1 --agent bob --resolution obsolete"]]
    },
    "env": { "ATM_AGENT": "bob", "ATM_NOW": "2026-05-01T12:00:00Z" },
    "args": ["reopen", "T-1", "--reason", "Needed after all", "--json"],
    "expect": {
      "json": {
        "id": "T-1",
        "status": "todo",
        "updated_at": "2026-05-01T12:00:00Z",
        "updated_by": "bob",
        "notes": [{ "at": "2026-05-01T12:00:00Z", "by": "bob", "kind": "note", "text": "Reopened: Needed after all" }],
        "claim": null
      }
    }
  },
  {
    "name": "show: the resolution, related tasks on both sides, and what duplicates it",
    "setup": {
      "files": {
        ".agentic-task-manager/tasks.json": {
          "tasks": [
            { "id": "T-1", "name": "One", "type": "feature", "status": "done", "related": ["T-3"] },
            {
              "id": "T-2",
              "name": "Two",
              "type": "feature",
              "status": "skipped",
              "resolution": "duplicate",
              "duplicate_of": "T-1"
            },
            { "id": "T-3", "name": "Three", "type": "feature", "status": "todo", "related": ["T-4"] },
            { "id": "T-4", "name": "Four", "type": "feature", "status": "todo" }
          ]
        }
      }
    },
    "args": ["show", "T-1", "T-2", "T-3"],
    "expect": {
      "stdout": "T-1  One\n  done · backlog · feature · P2\n  related: T-3\n  duplicated by: T-2\n\nT-2  Two\n  skipped · backlog · feature · P2\n  resolution: duplicate (of T-1)\n\nT-3  Three\n  todo · backlog · feature · P2\n  related: T-4, T-1\n"
    }
  },
  {
    "name": "relations don't affect readiness: a task related to an unfinished one is next",
    "setup": {
      "files": {
        ".agentic-task-manager/tasks.json": {
          "tasks": [
            { "id": "T-1", "name": "One", "type": "feature", "status": "todo", "related": ["T-2"] },
            { "id": "T-2", "name": "Two", "type": "feature", "status": "blocked" }
          ]
        }
      }
    },
    "args": ["next"],
    "expect": { "stdout": "Next: T-1 One (backlog, feature)\n" }
  },
  {
    "name": "check: a resolution on an open task, an unknown one, duplicate_of without it or to nothing, related to nothing",
    "setup": {
      "files": {
        ".agentic-task-manager/tasks.json": {
          "tasks": [
            { "id": "T-1", "name": "A", "type": "feature", "status": "todo", "resolution": "obsolete" },
            { "id": "T-2", "name": "B", "type": "feature", "status": "done", "resolution": "finished" },
            { "id": "T-3", "name": "C", "type": "feature", "status": "skipped", "duplicate_of": "T-9" },
            { "id": "T-4", "name": "D", "type": "feature", "status": "todo", "related": ["T-4", "T-8"] }
          ]
        }
      }
    },
    "args": ["check"],
    "expect": {
      "exit": 1,
      "stdout": "error: T-1: has a resolution (obsolete) but isn't done or skipped\nerror: T-2: the resolution 'finished' is not one of done, wont_do, duplicate, obsolete\nerror: T-3: duplicate_of needs the resolution duplicate\nerror: T-3: duplicate_of 'T-9' isn't another task\nerror: T-4: related to T-4, which isn't another task\nerror: T-4: related to T-8, which isn't another task\n"
    }
  },
  {
    "name": "the merge driver merges related as a set: both sides' additions stay, a removal goes",
    "setup": {
      "files": {
        "base.json": { "tasks": [{ "id": "T-1", "status": "todo", "related": ["T-2", "T-3"] }] },
        "ours.json": { "tasks": [{ "id": "T-1", "status": "todo", "related": ["T-2", "T-3", "T-4"] }] },
        "theirs.json": { "tasks": [{ "id": "T-1", "status": "todo", "related": ["T-3", "T-5"] }] }
      }
    },
    "args": ["merge-driver", "base.json", "ours.json", "theirs.json"],
    "expect": {
      "exit": 0,
      "files": { "ours.json": { "tasks": [{ "id": "T-1", "status": "todo", "related": ["T-3", "T-4", "T-5"] }] } }
    }
  }
]
