[
  {
    "name": "block: in progress -> blocked, waiting on the user with the open questions; the claim is released",
    "setup": {
      "git": true,
      "files": { ".agentic-task-manager/tasks.json": { "tasks": [{ "id": "T-1", "status": "todo" }] } },
      "commands": [["sh", "-c", "ATM_NOW=2026-05-01T10:00:00Z \"$ATM\" start T-1 --agent alice"]]
    },
    "args": ["block", "T-1", "--on", "user", "--question", "Which API?", "--question", "Keep v1?", "--json"],
    "env": { "ATM_NOW": "2026-05-01T10:10:00Z", "ATM_AGENT": "alice" },
    "expect": {
      "json": {
        "id": "T-1",
        "status": "blocked",
        "updated_at": "2026-05-01T10:10:00Z",
        "updated_by": "alice",
        "started_at": "2026-05-01T10:00:00Z",
        "started_by": "alice",
        "waiting_on": "user",
        "questions": ["Which API?", "Keep v1?"],
        "blocked_at": "2026-05-01T10:10:00Z",
        "claim": null
      }
    }
  },
  {
    "name": "block a to-do task on another agent, with a reason",
    "setup": { "files": { ".agentic-task-manager/tasks.json": { "tasks": [{ "id": "T-1", "status": "todo" }] } } },
    "args": ["block", "T-1", "--on", "agent", "--reason", "Needs the reviewer agent's call on the schema"],
    "env": { "ATM_NOW": "2026-05-01T10:00:00Z", "ATM_AGENT": "alice" },
    "expect": {
      "stdout": "T-1: todo -> blocked\n",
      "files": {
        ".agentic-task-manager/tasks.json": {
          "tasks": [
            {
              "id": "T-1",
              "status": "blocked",
              "updated_at": "2026-05-01T10:00:00Z",
              "updated_by": "alice",
              "waiting_on": "agent",
              "questions": [],
              "blocked_at": "2026-05-01T10:00:00Z",
              "notes": [
                {
                  "at": "2026-05-01T10:00:00Z",
                  "kind": "note",
                  "text": "Needs the reviewer agent's call on the schema",
                  "by": "alice"
                }
              ]
            }
          ]
        }
      }
    }
  },
  {
    "name": "unblock: back to todo; the questions and answers become an answer note",
    "setup": {
      "files": {
        ".agentic-task-manager/tasks.json": {
          "tasks": [
            {
              "id": "T-1",
              "status": "blocked",
              "started_at": "2026-05-01T09:00:00Z",
              "started_by": "alice",
              "waiting_on": "user",
              "questions": ["Which API?", "Keep v1?"],
              "blocked_at": "2026-05-01T09:30:00Z"
            }
          ]
        }
      }
    },
    "args": ["unblock", "T-1", "--answer", "The REST one", "--answer", "No"],
    "env": { "ATM_NOW": "2026-05-01T10:00:00Z", "ATM_AGENT": "Hakan" },
    "expect": {
      "stdout": "T-1: blocked -> todo\n",
      "files": {
        ".agentic-task-manager/tasks.json": {
          "tasks": [
            {
              "id": "T-1",
              "status": "todo",
              "updated_at": "2026-05-01T10:00:00Z",
              "updated_by": "Hakan",
              "notes": [
                {
                  "at": "2026-05-01T10:00:00Z",
                  "kind": "answer",
                  "text": "Which API? → The REST one; Keep v1? → No",
                  "by": "Hakan"
                }
              ]
            }
          ]
        }
      }
    }
  },
  {
    "name": "unblock with fewer answers than questions says which went unanswered",
    "setup": {
      "files": {
        ".agentic-task-manager/tasks.json": {
          "tasks": [{ "id": "T-1", "status": "blocked", "waiting_on": "user", "questions": ["A?", "B?"] }]
        }
      }
    },
    "args": ["unblock", "T-1", "--answer", "Yes", "--json"],
    "env": { "ATM_NOW": "2026-05-01T10:00:00Z", "ATM_AGENT": "Hakan" },
    "expect": {
      "json": {
        "id": "T-1",
        "status": "todo",
        "updated_at": "2026-05-01T10:00:00Z",
        "updated_by": "Hakan",
        "notes": [
          { "at": "2026-05-01T10:00:00Z", "kind": "answer", "text": "A? → Yes; B? → (no answer)", "by": "Hakan" }
        ],
        "claim": null
      }
    }
  },
  {
    "name": "block needs --on, and a question or a reason",
    "setup": { "files": { ".agentic-task-manager/tasks.json": { "tasks": [{ "id": "T-1", "status": "todo" }] } } },
    "args": ["block", "T-1", "--on", "user"],
    "env": { "ATM_AGENT": "alice" },
    "expect": { "exit": 2, "stderrIncludes": ["say what it waits for: --question (repeatable) or --reason"] }
  },
  {
    "name": "block --on must be user or agent",
    "setup": { "files": { ".agentic-task-manager/tasks.json": { "tasks": [{ "id": "T-1", "status": "todo" }] } } },
    "args": ["block", "T-1", "--on", "team", "--question", "?"],
    "expect": { "exit": 2, "stderrIncludes": ["argument --on: invalid choice: 'team'"] }
  },
  {
    "name": "block refuses a finished task; unblock refuses a task that isn't blocked",
    "setup": { "files": { ".agentic-task-manager/tasks.json": { "tasks": [{ "id": "T-1", "status": "done" }] } } },
    "args": ["block", "T-1", "--on", "user", "--question", "?"],
    "env": { "ATM_AGENT": "alice" },
    "expect": { "exit": 1, "stderrIncludes": ["can't block T-1: it is done, not todo or in_progress"] }
  },
  {
    "name": "unblock refuses a task that isn't blocked",
    "setup": { "files": { ".agentic-task-manager/tasks.json": { "tasks": [{ "id": "T-1", "status": "todo" }] } } },
    "args": ["unblock", "T-1"],
    "env": { "ATM_AGENT": "alice" },
    "expect": { "exit": 1, "stderrIncludes": ["can't unblock T-1: it is todo, not blocked"] }
  },
  {
    "name": "a blocked task keeps its dependents waiting; status says what it waits on",
    "setup": {
      "files": {
        ".agentic-task-manager/tasks.json": {
          "tasks": [
            { "id": "T-1", "name": "Decide", "status": "blocked", "waiting_on": "user", "questions": ["Which API?"] },
            { "id": "T-2", "name": "Build", "status": "todo", "dependencies": ["T-1"] }
          ]
        }
      }
    },
    "args": ["status"],
    "expect": {
      "stdoutIncludes": [
        "blocked: T-1 Decide (on user)\n",
        "waiting on dependencies: T-2 Build (on T-1)\n",
        "next: none (1 todo task(s) waiting on dependencies)\n"
      ]
    }
  }
]
