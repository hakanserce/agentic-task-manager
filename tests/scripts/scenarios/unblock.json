[
  {
    "name": "unblock records long questions and answers together, even past one note's 500 characters",
    "setup": {
      "files": {
        ".agentic-task-manager/tasks.json": {
          "tasks": [
            {
              "id": "T-1",
              "status": "blocked",
              "waiting_on": "user",
              "blocked_at": "2026-05-01T09:00:00Z",
              "questions": [
                "Q1 xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx?",
                "Q2 yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy?"
              ]
            }
          ]
        }
      }
    },
    "args": ["unblock", "T-1", "--answer", "Yes", "--answer", "No"],
    "env": { "ATM_NOW": "2026-05-02T10:00:00Z", "ATM_AGENT": "alice" },
    "expect": { "stdoutIncludes": ["T-1: blocked -> todo"] }
  },
  {
    "name": "an answer longer than 500 characters is still refused, and nothing changes",
    "setup": {
      "files": {
        ".agentic-task-manager/tasks.json": {
          "tasks": [{ "id": "T-1", "status": "blocked", "waiting_on": "user", "questions": ["Which?"] }]
        }
      }
    },
    "args": [
      "unblock",
      "T-1",
      "--answer",
      ""
    ],
    "expect": {
      "exit": 2,
      "stderrIncludes": ["a note is at most 500 characters"],
      "files": {
        ".agentic-task-manager/tasks.json": {
          "tasks": [{ "id": "T-1", "status": "blocked", "waiting_on": "user", "questions": ["Which?"] }]
        }
      }
    }
  }
]
