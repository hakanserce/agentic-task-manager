[
  {
    "name": "skip: a todo task that isn't needed; the reason stays as a note",
    "setup": { "files": { ".agentic-task-manager/tasks.json": { "tasks": [{ "id": "T-001", "status": "todo" }] } } },
    "env": { "ATM_AGENT": "bob", "ATM_NOW": "2026-05-01T12:00:00Z" },
    "args": ["skip", "T-001", "--reason", "Covered by T-002"],
    "expect": {
      "stdout": "T-001: todo -> skipped\n",
      "files": {
        ".agentic-task-manager/tasks.json": {
          "tasks": [
            {
              "id": "T-001",
              "status": "skipped",
              "updated_at": "2026-05-01T12:00:00Z",
              "updated_by": "bob",
              "skipped_at": "2026-05-01T12:00:00Z",
              "notes": [
                { "at": "2026-05-01T12:00:00Z", "by": "bob", "kind": "note", "text": "Skipped: Covered by T-002" }
              ]
            }
          ]
        }
      }
    }
  },
  {
    "name": "skip a blocked task: its open questions go, the block is kept as an interval",
    "setup": {
      "files": {
        ".agentic-task-manager/tasks.json": {
          "tasks": [
            {
              "id": "T-001",
              "status": "blocked",
              "waiting_on": "user",
              "questions": ["Which one?"],
              "blocked_at": "2026-05-01T09:00:00Z"
            }
          ]
        }
      }
    },
    "env": { "ATM_AGENT": "bob", "ATM_NOW": "2026-05-01T12:00:00Z" },
    "args": ["skip", "T-001", "--reason", "Not needed"],
    "expect": {
      "files": {
        ".agentic-task-manager/tasks.json": {
          "tasks": [
            {
              "id": "T-001",
              "status": "skipped",
              "updated_at": "2026-05-01T12:00:00Z",
              "updated_by": "bob",
              "skipped_at": "2026-05-01T12:00:00Z",
              "blocks": [{ "from": "2026-05-01T09:00:00Z", "to": "2026-05-01T12:00:00Z", "on": "user" }],
              "notes": [{ "at": "2026-05-01T12:00:00Z", "by": "bob", "kind": "note", "text": "Skipped: Not needed" }]
            }
          ]
        }
      }
    }
  },
  {
    "name": "skip needs a reason",
    "setup": { "files": { ".agentic-task-manager/tasks.json": { "tasks": [{ "id": "T-001", "status": "todo" }] } } },
    "args": ["skip", "T-001"],
    "expect": { "exit": 2, "stderrIncludes": ["--reason"] }
  },
  {
    "name": "skip refuses a task that is in progress or done",
    "setup": { "files": { ".agentic-task-manager/tasks.json": { "tasks": [{ "id": "T-001", "status": "done" }] } } },
    "args": ["skip", "T-001", "--reason", "x"],
    "expect": { "exit": 1, "stderrIncludes": ["can't skip T-001: it is done, not todo or blocked"] }
  }
]
