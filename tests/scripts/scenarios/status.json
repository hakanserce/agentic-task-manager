  {
    "name": "start: todo -> in_progress, sets started_at, keeps the rest",
    "setup": {
      "files": {
        ".agentic-task-manager/tasks.json": {
          "meta": {
            "project": "S"
          },
          "tasks": [
            {
              "id": "T-001",
              "name": "Task T-001",
              "phase": 0,
              "type": "feature",
              "description": "d",
              "status": "done",
              "dependencies": [],
              "updated_at": "2026-04-01T00:00:00Z"
            },
            {
              "id": "T-002",
              "name": "Task T-002",
              "phase": 0,
              "type": "feature",
              "description": "d",
              "status": "todo",
              "dependencies": ["T-001"],
              "updated_at": "2026-04-01T00:00:00Z",
              "completed_at": "2026-03-01T00:00:00Z",
              "extra": "kept"
            }
          ]
        }
      }
    },
    "args": ["start", "T-002"],
    "expect": {
      "stdout": "T-002: todo -> in_progress\n",
      "files": {
        ".agentic-task-manager/tasks.json": {
          "meta": {
            "project": "S"
          },
          "tasks": [
            {
              "id": "T-001",
              "name": "Task T-001",
              "phase": 0,
              "type": "feature",
              "description": "d",
              "status": "done",
              "dependencies": [],
              "updated_at": "2026-04-01T00:00:00Z"
            },
            {
              "id": "T-002",
              "name": "Task T-002",
              "phase": 0,
              "type": "feature",
              "description": "d",
              "status": "in_progress",
              "dependencies": ["T-001"],
              "updated_at": "2026-05-01T10:00:00Z",
              "extra": "kept",
              "started_at": "2026-05-01T10:00:00Z",
              "agent": "alice"
            }
          ]
        }
      }
    },
    "env": {
      "ATM_NOW": "2026-05-01T10:00:00Z",
      "ATM_AGENT": "alice"
    }
  },
