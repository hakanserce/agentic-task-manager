[
  {
    "name": "pr records the PR on each task, and moves a re-recorded task out of Merged",
    "setup": {
      "files": {
        ".agentic-task-manager/tasks.json": {
          "tasks": [
            { "id": "T-001", "status": "done" },
            { "id": "T-002", "status": "done", "pr": { "number": 3, "url": "u3" }, "merged_at": "2026-04-01T00:00:00Z" }
          ]
        }
      }
    },
    "env": { "ATM_AGENT": "alice", "ATM_NOW": "2026-05-01T12:00:00Z" },
    "args": ["pr", "T-001", "T-002", "--number", "7", "--url", "https://github.com/o/r/pull/7"],
    "expect": {
      "stdout": "T-001, T-002: in PR #7 (https://github.com/o/r/pull/7)\n",
      "files": {
        ".agentic-task-manager/tasks.json": {
          "tasks": [
            {
              "id": "T-001",
              "status": "done",
              "pr": { "number": 7, "url": "https://github.com/o/r/pull/7" },
              "updated_at": "2026-05-01T12:00:00Z",
              "updated_by": "alice"
            },
            {
              "id": "T-002",
              "status": "done",
              "pr": { "number": 7, "url": "https://github.com/o/r/pull/7" },
              "updated_at": "2026-05-01T12:00:00Z",
              "updated_by": "alice"
            }
          ]
        }
      }
    }
  },
  {
    "name": "pr with an unknown task changes nothing",
    "setup": { "files": { ".agentic-task-manager/tasks.json": { "tasks": [{ "id": "T-001", "status": "done" }] } } },
    "args": ["pr", "T-001", "T-009", "--number", "7", "--url", "https://example.com/pr/7"],
    "expect": {
      "exit": 1,
      "stderrIncludes": ["T-009"],
      "files": { ".agentic-task-manager/tasks.json": { "tasks": [{ "id": "T-001", "status": "done" }] } }
    }
  },
  {
    "name": "pr needs --number and --url",
    "setup": { "files": { ".agentic-task-manager/tasks.json": { "tasks": [{ "id": "T-001", "status": "done" }] } } },
    "args": ["pr", "T-001", "--number", "7"],
    "expect": { "exit": 2, "stderrIncludes": ["--url"] }
  },
  {
    "name": "merged sets merged_at on that PR's tasks only",
    "setup": {
      "files": {
        ".agentic-task-manager/tasks.json": {
          "tasks": [
            { "id": "T-001", "status": "done", "pr": { "number": 7, "url": "u" } },
            { "id": "T-002", "status": "done", "pr": { "number": 8, "url": "v" } }
          ]
        }
      }
    },
    "env": { "ATM_AGENT": "alice", "ATM_NOW": "2026-05-01T12:00:00Z" },
    "args": ["merged", "--pr", "7", "--at", "2026-04-30T09:00:00Z", "--json"],
    "expect": {
      "json": { "pr": 7, "tasks": ["T-001"], "already": [], "released": [], "pending": {} },
      "files": {
        ".agentic-task-manager/tasks.json": {
          "tasks": [
            {
              "id": "T-001",
              "status": "done",
              "pr": { "number": 7, "url": "u" },
              "merged_at": "2026-04-30T09:00:00Z",
              "updated_at": "2026-05-01T12:00:00Z",
              "updated_by": "alice"
            },
            { "id": "T-002", "status": "done", "pr": { "number": 8, "url": "v" } }
          ]
        }
      }
    }
  },
  {
    "name": "merged twice keeps the first merge time",
    "setup": {
      "files": {
        ".agentic-task-manager/tasks.json": {
          "tasks": [
            { "id": "T-001", "status": "done", "pr": { "number": 7, "url": "u" }, "merged_at": "2026-04-30T09:00:00Z" }
          ]
        }
      }
    },
    "args": ["merged", "--pr", "7"],
    "expect": { "stdout": "PR #7: already recorded as merged\n" }
  },
  {
    "name": "merged for a PR no task records",
    "setup": { "files": { ".agentic-task-manager/tasks.json": { "tasks": [{ "id": "T-001", "status": "done" }] } } },
    "args": ["merged", "--pr", "7"],
    "expect": { "exit": 1, "stderrIncludes": ["no task records PR #7"] }
  },
  {
    "name": "list --in-pr: tasks in a PR not recorded as merged, with the PR in --json",
    "setup": {
      "files": {
        ".agentic-task-manager/tasks.json": {
          "tasks": [
            { "id": "T-001", "name": "a", "status": "done", "pr": { "number": 7, "url": "u7" } },
            {
              "id": "T-002",
              "name": "b",
              "status": "done",
              "pr": { "number": 6, "url": "u6" },
              "merged_at": "2026-04-30T09:00:00Z"
            },
            { "id": "T-003", "name": "c", "status": "done" }
          ]
        }
      }
    },
    "args": ["list", "--in-pr", "--json"],
    "expect": {
      "json": [
        {
          "id": "T-001",
          "status": "done",
          "kind": "done",
          "sprint": null,
          "priority": "P2",
          "labels": [],
          "name": "a",
          "pr": { "number": 7, "url": "u7" },
          "merged_at": null
        }
      ]
    }
  },
  {
    "name": "merged --at needs an ISO time",
    "setup": { "files": { ".agentic-task-manager/tasks.json": { "tasks": [] } } },
    "args": ["merged", "--pr", "7", "--at", "yesterday"],
    "expect": { "exit": 2, "stderrIncludes": ["--at needs a time like"] }
  },
  {
    "name": "merged releases a planned release whose tasks are all merged in the PR, its own or by sprint (SR-3.7)",
    "setup": {
      "files": {
        ".agentic-task-manager/tasks.json": {
          "meta": {
            "sprints": [{ "id": "A", "state": "active", "release": "1.0" }],
            "releases": [{ "id": "1.0" }]
          },
          "tasks": [
            {
              "id": "T-1",
              "status": "done",
              "sprint": "A",
              "pr": { "number": 7, "url": "https://github.com/o/r/pull/7" }
            },
            {
              "id": "T-2",
              "status": "done",
              "release": "1.0",
              "pr": { "number": 7, "url": "https://github.com/o/r/pull/7" }
            },
            { "id": "T-3", "status": "skipped", "sprint": "A" }
          ]
        }
      }
    },
    "args": ["merged", "--pr", "7", "--at", "2026-05-10T09:00:00Z"],
    "env": { "ATM_NOW": "2026-05-10T10:00:00Z", "ATM_AGENT": "alice" },
    "expect": {
      "stdout": "PR #7 merged: T-1, T-2\nReleased 1.0: all its tasks are merged in PR #7.\n",
      "files": {
        ".agentic-task-manager/tasks.json": {
          "meta": {
            "sprints": [{ "id": "A", "state": "active", "release": "1.0" }],
            "releases": [
              {
                "id": "1.0",
                "state": "released",
                "pr": { "number": 7, "url": "https://github.com/o/r/pull/7" },
                "released_at": "2026-05-10T09:00:00Z"
              }
            ]
          },
          "tasks": [
            {
              "id": "T-1",
              "status": "done",
              "sprint": "A",
              "pr": { "number": 7, "url": "https://github.com/o/r/pull/7" },
              "merged_at": "2026-05-10T09:00:00Z",
              "updated_at": "2026-05-10T10:00:00Z",
              "updated_by": "alice"
            },
            {
              "id": "T-2",
              "status": "done",
              "release": "1.0",
              "pr": { "number": 7, "url": "https://github.com/o/r/pull/7" },
              "merged_at": "2026-05-10T09:00:00Z",
              "updated_at": "2026-05-10T10:00:00Z",
              "updated_by": "alice"
            },
            { "id": "T-3", "status": "skipped", "sprint": "A" }
          ]
        }
      }
    }
  },
  {
    "name": "merged leaves a release planned while some of its tasks are outside the PR, and says which",
    "setup": {
      "files": {
        ".agentic-task-manager/tasks.json": {
          "meta": { "releases": [{ "id": "1.0" }, { "id": "0.9", "state": "released" }] },
          "tasks": [
            { "id": "T-1", "status": "done", "release": "1.0", "pr": { "number": 7, "url": "https://x/pull/7" } },
            { "id": "T-2", "status": "todo", "release": "1.0" },
            { "id": "T-3", "status": "done", "release": "0.9", "pr": { "number": 7, "url": "https://x/pull/7" } }
          ]
        }
      }
    },
    "args": ["merged", "--pr", "7", "--json"],
    "env": { "ATM_NOW": "2026-05-10T10:00:00Z" },
    "expect": {
      "json": { "pr": 7, "tasks": ["T-1", "T-3"], "already": [], "released": [], "pending": { "1.0": ["T-2"] } }
    }
  }
]
