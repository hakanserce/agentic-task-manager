[
  {
    "name": "tracked docs/tasks.json and dashboard: git mv, dashboard leaves git, folder set up",
    "setup": {
      "commit": true,
      "files": {
        "docs/tasks.json": {
          "meta": {
            "project": "P"
          },
          "tasks": []
        },
        "docs/tasks-dashboard.html": "<meta name=\"atm-dashboard-version\" content=\"0.4.0\">",
        "docs/plan.md": "plans stay"
      }
    },
    "args": ["migrate"],
    "expect": {
      "stdout": "Moved docs/tasks.json to .agentic-task-manager/tasks.json (staged with git mv, not committed); removed docs/tasks-dashboard.html (the dashboard now comes with the plugin: /atm:serve).\n",
      "files": {
        "docs/tasks.json": false,
        "docs/tasks-dashboard.html": false,
        "docs/plan.md": "plans stay",
        ".agentic-task-manager/tasks.json": {
          "meta": {
            "project": "P"
          },
          "tasks": []
        },
        ".agentic-task-manager/tasks-dashboard.html": false,
        ".agentic-task-manager/.gitignore": "# atm runtime files (managed by atm)\ntasks-dashboard.html\n.server.json\n.server.log\nclaims.json\nclaims-store.json\n.lock/\n",
        ".agentic-task-manager/.gitattributes": "# 'atm' is defined in each clone's git config (merge.atm.driver), registered by the atm plugin on every run.\n# Without it, git merges tasks.json line by line as usual.\ntasks.json merge=atm\n",
        ".agentic-task-manager/claims.json": true
      },
      "git": {
        "staged": [
          "R docs/tasks.json .agentic-task-manager/tasks.json",
          "D docs/tasks-dashboard.html",
          "A .agentic-task-manager/.gitignore",
          "A .agentic-task-manager/.gitattributes"
        ]
      }
    }
  },
  {
    "name": "--json describes the migration",
    "setup": {
      "commit": true,
      "files": {
        "docs/tasks.json": {
          "tasks": []
        },
        "docs/tasks-dashboard.html": "old"
      }
    },
    "args": ["migrate", "--json"],
    "expect": {
      "json": {
        "moved": {
          "from": "docs/tasks.json",
          "to": ".agentic-task-manager/tasks.json",
          "git": true
        },
        "removed_dashboard": "docs/tasks-dashboard.html",
        "warning": null,
        "gitignore_updated": true,
        "merge_driver_updated": true,
        "cleaned_up": null,
        "finish_times_filled": 0,
        "sprints_from_phases": null,
        "with_user_from_label": 0
      }
    }
  },
  {
    "name": "untracked tasks.json in the root of a git repository: plain move",
    "setup": {
      "git": true,
      "files": {
        "tasks.json": {
          "tasks": []
        }
      }
    },
    "args": ["migrate"],
    "expect": {
      "stdout": "Moved tasks.json to .agentic-task-manager/tasks.json.\n",
      "files": {
        "tasks.json": false,
        ".agentic-task-manager/tasks.json": {
          "tasks": []
        },
        ".agentic-task-manager/tasks-dashboard.html": false
      },
      "git": {
        "staged": ["A .agentic-task-manager/.gitignore", "A .agentic-task-manager/.gitattributes"]
      }
    }
  },
  {
    "name": "outside git: plain move of docs/tasks.json and its dashboard",
    "setup": {
      "files": {
        "docs/tasks.json": {
          "tasks": []
        },
        "docs/tasks-dashboard.html": "old"
      }
    },
    "cwd": "docs",
    "args": ["migrate"],
    "expect": {
      "stdout": "Moved docs/tasks.json to .agentic-task-manager/tasks.json; removed docs/tasks-dashboard.html (the dashboard now comes with the plugin: /atm:serve).\n",
      "files": {
        "docs/tasks.json": false,
        "docs/tasks-dashboard.html": false,
        ".agentic-task-manager/tasks.json": {
          "tasks": []
        },
        ".agentic-task-manager/.gitignore": true
      }
    }
  },
  {
    "name": "both locations exist: nothing moves, a warning, the new folder is used",
    "setup": {
      "commit": true,
      "files": {
        "docs/tasks.json": {
          "tasks": ["old"]
        },
        ".agentic-task-manager/tasks.json": {
          "tasks": ["new"]
        }
      }
    },
    "args": ["migrate"],
    "expect": {
      "stdout": "warning: both docs/tasks.json and .agentic-task-manager/tasks.json exist; using .agentic-task-manager/tasks.json. Remove the old file when you no longer need it.\n",
      "files": {
        "docs/tasks.json": {
          "tasks": ["old"]
        },
        ".agentic-task-manager/tasks.json": {
          "tasks": ["new"]
        }
      },
      "git": {
        "staged": ["A .agentic-task-manager/.gitignore", "A .agentic-task-manager/.gitattributes"]
      }
    }
  },
  {
    "name": "already set up: nothing to do, files untouched",
    "setup": {
      "files": {
        ".agentic-task-manager/tasks.json": {
          "tasks": []
        },
        ".agentic-task-manager/.gitignore": "tasks-dashboard.html\n.server.json\n.server.log\nclaims.json\nclaims-store.json\n.lock/\n"
      }
    },
    "args": ["migrate"],
    "expect": {
      "stdout": "Nothing to migrate.\n",
      "files": {
        ".agentic-task-manager/.gitignore": "tasks-dashboard.html\n.server.json\n.server.log\nclaims.json\nclaims-store.json\n.lock/\n",
        ".agentic-task-manager/tasks-dashboard.html": false
      }
    }
  },
  {
    "name": "an existing .gitignore keeps its lines and gains the missing entries",
    "setup": {
      "files": {
        ".agentic-task-manager/tasks.json": {
          "tasks": []
        },
        ".agentic-task-manager/.gitignore": "notes.txt\n.server.json"
      }
    },
    "args": ["migrate"],
    "expect": {
      "stdout": "Nothing to migrate.\n",
      "files": {
        ".agentic-task-manager/.gitignore": "notes.txt\n.server.json\ntasks-dashboard.html\n.server.log\nclaims.json\nclaims-store.json\n.lock/\n"
      }
    }
  },
  {
    "name": "a project's old copy of the dashboard is removed",
    "setup": {
      "files": {
        ".agentic-task-manager/tasks.json": {
          "tasks": []
        },
        ".agentic-task-manager/.gitignore": "tasks-dashboard.html\n.server.json\n.server.log\nclaims.json\nclaims-store.json\n.lock/\n",
        ".agentic-task-manager/tasks-dashboard.html": "<meta name=\"atm-dashboard-version\" content=\"0.14.0\">"
      }
    },
    "args": ["migrate"],
    "expect": {
      "stdout": "Removed this project's old dashboard files: one dashboard for all your projects now comes with the plugin (/atm:serve).\n",
      "files": {
        ".agentic-task-manager/tasks-dashboard.html": false
      }
    }
  },
  {
    "name": "an old server's record (its process gone) and log are removed",
    "setup": {
      "files": {
        ".agentic-task-manager/tasks.json": {
          "tasks": []
        },
        ".agentic-task-manager/.gitignore": "tasks-dashboard.html\n.server.json\n.server.log\nclaims.json\nclaims-store.json\n.lock/\n",
        ".agentic-task-manager/.server.json": {
          "pid": 999999,
          "port": 1,
          "folder": "/nowhere"
        },
        ".agentic-task-manager/.server.log": "old log\n"
      }
    },
    "args": ["migrate", "--json"],
    "expect": {
      "json": {
        "moved": null,
        "removed_dashboard": null,
        "warning": null,
        "gitignore_updated": false,
        "merge_driver_updated": false,
        "cleaned_up": { "dashboard": false, "server": null },
        "finish_times_filled": 0,
        "sprints_from_phases": null,
        "with_user_from_label": 0
      },
      "files": {
        ".agentic-task-manager/.server.json": false,
        ".agentic-task-manager/.server.log": false
      }
    }
  },
  {
    "name": "no tasks.json anywhere: nothing is created",
    "setup": {
      "git": true
    },
    "args": ["migrate"],
    "expect": {
      "stdout": "No tasks.json found. Run /atm:create-tasks to create one.\n",
      "files": {
        ".agentic-task-manager": false
      }
    }
  },
  {
    "name": "running twice is harmless",
    "setup": {
      "commit": true,
      "files": {
        "docs/tasks.json": {
          "tasks": []
        },
        "docs/tasks-dashboard.html": "old"
      },
      "commands": [["sh", "-c", "\"$ATM\" migrate"]]
    },
    "args": ["migrate"],
    "expect": {
      "stdout": "Nothing to migrate.\n"
    }
  }
]
