  {
    "name": "priority: the most urgent goes first, before a lower ID",
    "setup": {
      "files": {
        ".agentic-task-manager/tasks.json": {
          "tasks": [
            { "id": "T-1", "name": "Low", "phase": 0, "type": "feature", "status": "todo", "priority": "P3" },
            { "id": "T-2", "name": "Default", "phase": 0, "type": "feature", "status": "todo" },
            { "id": "T-3", "name": "Urgent", "phase": 0, "type": "feature", "status": "todo", "priority": "P0" }
          ]
        }
      }
    },
    "args": ["next"],
    "expect": { "stdout": "Next: T-3 Urgent (backlog, feature)\n" }
