[
  {
    "name": "workflow: none set yet",
    "setup": { "files": { ".agentic-task-manager/tasks.json": { "tasks": [] } } },
    "args": ["workflow"],
    "expect": {
      "stdout": "No workflow set: /atm:push asks for one, or run `atm workflow set direct|pull-request`.\n"
    }
  },
  {
    "name": "workflow --json without one",
    "setup": { "files": { ".agentic-task-manager/tasks.json": { "tasks": [] } } },
    "args": ["workflow", "--json"],
    "expect": { "json": { "type": null } }
  },
  {
    "name": "workflow set: writes meta.workflow; the defaults fill in the rest",
    "setup": { "files": { ".agentic-task-manager/tasks.json": { "tasks": [] } } },
    "args": ["workflow", "set", "pull-request", "--base", "main", "--json"],
    "expect": {
      "json": {
        "verify": true,
        "max_rounds": 3,
        "commit_template": "feat({id}): {name}",
        "type": "pull-request",
        "base": "main"
      },
      "files": {
        ".agentic-task-manager/tasks.json": {
          "tasks": [],
          "meta": { "workflow": { "type": "pull-request", "base": "main" } }
        }
      }
    }
  },
  {
    "name": "workflow set keeps what it isn't told to change, and describes the result",
    "setup": {
      "files": {
        ".agentic-task-manager/tasks.json": {
          "meta": { "workflow": { "type": "pull-request", "base": "dev", "trailers": "forbid" } },
          "tasks": []
        }
      }
    },
    "args": ["workflow", "set", "direct", "--verify", "false", "--max-rounds", "5"],
    "expect": {
      "stdout": "workflow: direct\n  base: dev\n  verify before pushing: no\n  CI fix rounds: 5\n  commit message: feat({id}): {name}\n  trailers: none (Co-Authored-By lines are removed)\n",
      "files": {
        ".agentic-task-manager/tasks.json": {
          "meta": {
            "workflow": { "type": "direct", "base": "dev", "trailers": "forbid", "verify": false, "max_rounds": 5 }
          },
          "tasks": []
        }
      }
    }
  },
  {
    "name": "workflow set --trailers require takes the lines; --trailers none leaves them to the agent",
    "setup": { "files": { ".agentic-task-manager/tasks.json": { "tasks": [] } } },
    "args": [
      "workflow",
      "set",
      "pull-request",
      "--base",
      "main",
      "--trailers",
      "require",
      "--trailer",
      "Co-Authored-By: Claude <noreply@anthropic.com>"
    ],
    "expect": {
      "stdoutIncludes": ["  trailers: required: Co-Authored-By: Claude <noreply@anthropic.com>\n"],
      "files": {
        ".agentic-task-manager/tasks.json": {
          "meta": {
            "workflow": {
              "type": "pull-request",
              "base": "main",
              "trailers": { "require": ["Co-Authored-By: Claude <noreply@anthropic.com>"] }
            }
          },
          "tasks": []
        }
      }
    }
  },
  {
    "name": "workflow set needs a type",
    "setup": { "files": { ".agentic-task-manager/tasks.json": { "tasks": [] } } },
    "args": ["workflow", "set", "trunk"],
    "expect": { "exit": 2, "stderrIncludes": ["atm workflow set needs a type: direct or pull-request"] }
  },
  {
    "name": "an invalid meta.workflow is reported, naming the field",
    "setup": {
      "files": {
        ".agentic-task-manager/tasks.json": {
          "meta": { "workflow": { "type": "direct", "max_rounds": 0 } },
          "tasks": []
        }
      }
    },
    "args": ["workflow"],
    "expect": { "exit": 1, "stderrIncludes": ["atm: meta.workflow.max_rounds must be a positive whole number"] }
  },
  {
    "name": "workflow set --trailers require without lines",
    "setup": { "files": { ".agentic-task-manager/tasks.json": { "tasks": [] } } },
    "args": ["workflow", "set", "direct", "--trailers", "require"],
    "expect": { "exit": 2, "stderrIncludes": ["--trailers require needs at least one --trailer LINE"] }
  }
]
